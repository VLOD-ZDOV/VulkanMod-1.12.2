vulkanmod112.ui.gpu=GPU
vulkanmod112.ui.vram=VRAM
vulkanmod112.ui.vulkan_unavailable=Vulkan 不可用
vulkanmod112.cost.none=无
vulkanmod112.cost.low=低
vulkanmod112.cost.medium=中
